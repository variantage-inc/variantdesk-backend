# Copy to .env and fill in. .env is git-ignored. Never commit real values.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Neon, on Variantage's own account. Take it from the Neon dashboard under
# Connect. sslmode=require is not optional. Neon refuses plaintext.
# This is a credential: .env is git-ignored, and if it leaks, rotate the
# password from the dashboard rather than hoping nobody noticed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/variantage?sslmode=require"

# Working offline? docker-compose.yml at the project root gives you the same
# thing locally, and Prisma cannot tell the difference:
# DATABASE_URL="postgresql://variantage:variantage@localhost:5433/variantage?schema=public"

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m

# Resend, for password resets and member invites. The real key lives in .env
# and nowhere else. Take it from the Resend dashboard.
RESEND_API_KEY=re_your_key_here

# Until variantage.com is verified as a domain in Resend, onboarding@resend.dev
# is the only sender allowed, and it can only deliver to the Resend account
# owner's own address. Real customers need the verified domain.
EMAIL_FROM=onboarding@resend.dev

# Where reset and invite links point.
APP_URL=http://localhost:3000

# Continue with Google. From Google Cloud Console, APIs and Services,
# Credentials. The redirect URI must match the one registered there exactly,
# including the port and with no trailing slash.
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
