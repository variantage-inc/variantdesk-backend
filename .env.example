# Copy to .env and fill in. .env is git-ignored. Never commit real values.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Neon, on Variantage's own account. Take it from the Neon dashboard under
# Connect. sslmode=require is not optional. Neon refuses plaintext.
# This is a credential: .env is git-ignored, and if it leaks, rotate the
# password from the dashboard rather than hoping nobody noticed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/variantage?sslmode=require"

# Working offline? docker-compose.yml at the project root gives you the same
# thing locally, and Prisma cannot tell the difference:
# DATABASE_URL="postgresql://variantage:variantage@localhost:5433/variantage?schema=public"

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m

# Resend, for password resets and member invites. The real key lives in .env
# and nowhere else. Take it from the Resend dashboard.
RESEND_API_KEY=re_your_key_here

# Until variantage.com is verified as a domain in Resend, onboarding@resend.dev
# is the only sender allowed, and it can only deliver to the Resend account
# owner's own address. Real customers need the verified domain.
EMAIL_FROM=onboarding@resend.dev

# Where reset and invite links point.
APP_URL=http://localhost:3000

# Continue with Google. From Google Cloud Console, APIs and Services,
# Credentials. The redirect URI must match the one registered there exactly,
# including the port and with no trailing slash.
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Stripe. All optional: the product runs its 14 day trial with none of these,
# and the billing routes answer 503 until the secret key and the two plan
# prices are set. Test keys start sk_test_ and price ids start price_.
#
# The three prices are created once in the Stripe dashboard, as recurring
# monthly prices in CAD: Essential $20, 360 Solutions $40, and an extra user
# at $5 with usage type licensed, so its quantity is the number of people.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PRICE_ESSENTIAL=price_essential_id
STRIPE_PRICE_SOLUTIONS_360=price_360_id
STRIPE_PRICE_EXTRA_USER=price_extra_user_id

# Webhook signing secret. In development, run:
#   stripe listen --forward-to localhost:4000/api/billing/webhook
# and paste the whsec_ value it prints. In production it comes from the
# endpoint you add in the Stripe dashboard. Without it webhooks are refused,
# because an unverified webhook is a stranger claiming somebody has paid.
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret

# Card payments on invoices (Phase 6b) arrive from each business's OWN Stripe
# account, through Stripe Connect. In development `stripe listen` signs those
# with the secret above, if it is started with --forward-connect-to as well as
# --forward-to. In production they come to a second endpoint in the dashboard
# ("Events on Connected accounts"), which has its own signing secret: put it
# here. Events: payment_intent.succeeded, payment_intent.payment_failed,
# charge.refunded, account.updated.
STRIPE_CONNECT_WEBHOOK_SECRET=

# ---- Voice entry (Phase 10) ----
# Gemini takes the audio directly and returns structured JSON, so one key does
# the whole job. Server side only: the browser never calls Gemini and never
# sees this value.
GEMINI_API_KEY=
# Optional. Overrides the model pinned in lib/gemini.ts, for when one starts
# answering badly and waiting for a deploy is not an option.
GEMINI_MODEL=

# ---- Neon Object Storage (Phase 8, receipts) ----
# Created with:
#   neon bucket create receipts --access-level private
# and the credentials pulled with:
#   neon env pull --service object-storage
#
# S3 compatible, so these are the AWS standard names and the SDK finds them on
# its own. They are BRANCH SCOPED: these belong to the development branch, and
# production issues its own, which is what stops a development upload ever
# appearing in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
STORAGE_BUCKET=receipts

# ---- Production (Phase 11) ----
# Error reporting. Leave empty and errors go to the log only.
SENTRY_DSN=

# The refresh cookie. `lax` when the web app and the API share a parent
# domain (app.variantage.com and api.variantage.com). `none` only if they are
# on unrelated domains, and then only over HTTPS.
COOKIE_SAMESITE=lax

# In production NODE_ENV=production also makes the API refuse to start with a
# localhost APP_URL or CORS_ORIGIN, a Stripe test key, a missing webhook
# secret, or the Resend sandbox sender. Migrations are applied with
#   npm run db:deploy
# as a deliberate step, never on boot.
