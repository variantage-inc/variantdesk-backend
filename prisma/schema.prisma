// =============================================================================
// Variantage Finance: database schema
//
// Built on the seven decisions in docs/data-model.html. The four that shape
// every model below, and must not be quietly undone:
//
//   · Money is stored as WHOLE CENTS in Int columns, never Decimal or Float.
//     0.1 has no exact binary representation, and a tax total a cent out is a
//     tax total that is wrong.
//   · Tax is STORED, never recalculated. Each row keeps the rate that applied
//     and the amount charged, so a rate change never rewrites history.
//     Nova Scotia went 15% to 14% in 2025 and old invoices must still show 15%.
//   · Nothing is truly deleted. `deletedAt` marks a row as removed. The CRA
//     wants six years, and an invoice number must never be reissued.
//   · Multi-tenant from day one. Every business-owned table carries businessId
//     and every query is scoped to it.
//
// This file currently covers the Account & access group, which is what Phase 2
// needs. The remaining groups are added in their own phases. See PLAN.md.
// =============================================================================

generator client {
  // Prisma 7 generates into the project rather than into node_modules, so the
  // client is visible, typed and committed-adjacent. `output` is required.
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7 no longer takes the URL here. Migrations read it from
  // prisma.config.ts, and the running client gets it through the pg adapter in
  // src/lib/prisma.ts. One env var still drives both.
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums ----

enum BusinessType {
  SOLE_PROPRIETOR
  PARTNERSHIP
  CORPORATION
  CONTRACTOR
}

enum Currency {
  CAD
  USD
  PKR
}

// Inside one business. The owner pays and controls membership.
enum BusinessRole {
  OWNER
  MEMBER
}

// Above tenancy. SUPERADMIN is Variantage staff and belongs to no business.
// A customer can never grant it.
enum PlatformRole {
  SUPERADMIN
  CUSTOMER
}

// The two plans. They unlock exactly the same software; the difference is
// whether a real person keeps the books. So this is a support routing flag,
// never a permission, and nothing in the code branches on it.
enum Plan {
  ESSENTIAL
  SOLUTIONS_360
}

// Mirrors Stripe's own subscription statuses, narrowed to the ones this
// product can actually be in. Kept as our own enum rather than a raw string so
// that a typo in a webhook handler is a compile error.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
  INCOMPLETE
}

enum PaymentStatus {
  PAID
  FAILED
  REFUNDED
}

enum CategoryKind {
  INCOME
  EXPENSE
  DRAWINGS
}

// What a row of money is. Owner drawings are their own type rather than a
// category on an expense, because the difference is not a label: a drawing
// must never reach net profit, an expense report, or an input tax credit.
// Enforcing that at query level on a typed column is a rule the code cannot
// forget; enforcing it by remembering to exclude a category is one it will.
enum TransactionType {
  INCOME
  EXPENSE
  DRAWING
}

// How the person typed the amount in. This is the single most common source of
// wrong entries in small business books, which is why it is asked once, in
// plain words, instead of being guessed.
enum TaxMode {
  ADD // the figure is before tax, so add it
  INCLUSIVE // the figure already includes tax, so work it back out
  NONE // no tax on this entry at all
}

enum PaymentMethod {
  BANK_TRANSFER
  E_TRANSFER
  CHEQUE
  CASH
  CARD
  PRE_AUTHORISED
  OTHER
}

// A ledger row is written once and never touched again. An edit writes a
// reversal and a replacement; a delete writes a reversal alone.
enum LedgerKind {
  ENTRY // something that happened
  REVERSAL // the cancellation of an ENTRY, with the amounts negated
}

// ------------------------------------------------------------- business ----
// The tenant. Everything else hangs off this row.
model Business {
  id           String       @id @default(cuid())
  name         String
  legalName    String?      @map("legal_name")
  businessType BusinessType @default(SOLE_PROPRIETOR) @map("business_type")

  // CRA identifiers. gstHstNumber is the 15-character registration
  // (e.g. 123456789 RT0001) and is printed on every invoice. Without it the
  // client can be refused their input tax credit.
  businessNumber String? @map("business_number")
  gstHstNumber   String? @map("gst_hst_number")
  gstRegistered  Boolean @default(false) @map("gst_registered")

  // Province drives the default tax rate, so it is not a free-text field.
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  province     String  @default("ON")
  postalCode   String? @map("postal_code")
  country      String  @default("CA")

  email   String?
  phone   String?
  website String?

  currency     Currency @default(CAD)
  dateFormat   String   @default("YYYY/MM/DD") @map("date_format")
  fyStartMonth Int      @default(1) @map("fy_start_month")

  // Invoice template, auto-filled on every new invoice so nothing is retyped.
  invoicePrefix     String  @default("INV-") @map("invoice_prefix")
  nextInvoiceNumber Int     @default(1) @map("next_invoice_number")
  invoiceNumberPad  Int     @default(4) @map("invoice_number_pad")
  paymentTermsDays  Int     @default(30) @map("payment_terms_days")
  invoiceTerms      String? @map("invoice_terms")
  invoiceFooter     String? @map("invoice_footer")
  invoicePayTo      String? @map("invoice_pay_to")

  // Basis points, so 200 is 2% a month. Not a money column and not a Decimal:
  // an integer rate cannot drift, and it prints on the invoice as written.
  lateInterestBp Int? @default(200) @map("late_interest_bp")

  logoKey String? @map("logo_key")

  // Web only. The phone stays signed in until manual logout.
  idleTimeoutMinutes Int @default(15) @map("idle_timeout_minutes")
  idleWarningSeconds Int @default(60) @map("idle_warning_seconds")

  users        User[]
  sessions     Session[]
  subscription Subscription?
  invites      Invite[]
  payments     Payment[]
  categories   Category[]
  vendors      Vendor[]
  clients      Client[]
  transactions Transaction[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("business")
}

// ----------------------------------------------------------------- user ----
model User {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  email String @unique

  /**
   * Nullable because an account created through Google has no password. A user
   * can later set one, and a password user can later link Google, so the two
   * are not exclusive.
   */
  passwordHash String? @map("password_hash")

  /**
   * Google's stable subject id, not the email. Google emails can change and be
   * reassigned; the subject id cannot.
   */
  googleId     String?      @unique @map("google_id")
  avatarUrl    String?      @map("avatar_url")
  firstName    String       @map("first_name")
  lastName     String       @map("last_name")
  role         BusinessRole @default(OWNER)
  platformRole PlatformRole @default(CUSTOMER) @map("platform_role")

  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  // Set when a reset is requested; the token itself is stored hashed and the
  // link is good for one use inside 60 minutes.
  resetTokenHash    String?   @map("reset_token_hash")
  resetTokenExpires DateTime? @map("reset_token_expires")

  sessions     Session[]
  transactions Transaction[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([businessId])
  @@map("user")
}

// -------------------------------------------------------------- session ----
// Drives the 15-minute idle logout on web. A refresh token is stored hashed so
// a database leak cannot be replayed as a login.
model Session {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique @map("refresh_token_hash")

  /**
   * Whether the person ticked "keep me signed in".
   * Stored on the session, not worked out from the expiry date, so a refresh
   * carries the original choice forward instead of quietly upgrading a shared
   * computer to a month long session.
   */
  remembered Boolean   @default(true)
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([businessId])
  @@map("session")
}

// -------------------------------------------------------- subscription ----
// One per business. Holds what Stripe knows, mirrored locally, so that
// deciding whether someone may write to their own books never depends on a
// network call to a third party.
//
// The only question this table has to answer is: may this business write right
// now, yes or no. Both plans unlock the same software, so there is no per
// feature entitlement anywhere in this codebase and there must not be one.
model Subscription {
  id         String   @id @default(cuid())
  businessId String   @unique @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  plan   Plan               @default(ESSENTIAL)
  status SubscriptionStatus @default(TRIALING)

  // People beyond the owner, 0 to 2, at $5 each and free until the trial ends.
  // Kept here rather than counted from the user table, because the bill has to
  // survive a member being removed halfway through a month.
  extraSeats Int @default(0) @map("extra_seats")

  // The trial is ours. It starts at signup and exists whether or not Stripe
  // has ever been contacted. When a card is added, this same instant is handed
  // to Stripe as trial_end, so nobody is quietly given 14 more days.
  trialEndsAt DateTime? @map("trial_ends_at")

  currentPeriodEnd  DateTime? @map("current_period_end")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")

  // Stripe's side. Nullable throughout, because an account inside its trial
  // has never been to checkout, and that is the ordinary state for 14 days.
  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")

  // The two subscription items: the plan line and the per seat line. Stored so
  // that a seat change is an update to a known item, rather than a search
  // through the subscription every time somebody is added.
  stripeBaseItemId String? @map("stripe_base_item_id")
  stripeSeatItemId String? @map("stripe_seat_item_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscription")
}

// ------------------------------------------------------------- payment ----
// Written from Stripe webhooks only, never from a request. A local copy of
// what Stripe charged, so the billing history and the superadmin panel can
// render a table without a Stripe API call.
model Payment {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Whole cents, like every other money column in this schema.
  amountCents Int           @map("amount_cents")
  currency    String        @default("cad")
  status      PaymentStatus
  description String?

  // Unique, so a webhook delivered twice cannot produce two rows.
  stripeInvoiceId String?   @unique @map("stripe_invoice_id")
  paidAt          DateTime? @map("paid_at")
  failureReason   String?   @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId])
  @@map("payment")
}

// ------------------------------------------------------- webhook event ----
// Stripe guarantees at-least-once delivery, which makes duplicates normal
// rather than exceptional. The event id is the primary key, so a replay is a
// unique violation instead of a second payment recorded.
model WebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("webhook_event")
}

// -------------------------------------------------------------- invite ----
// The owner types an email address, and that person sets their own password on
// a single use link. Deliberately not a generated password sent by email,
// which would sit in that inbox in plain text for as long as the account
// exists, so anyone who ever reaches the mailbox reaches the books.
model Invite {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  email String
  role  BusinessRole @default(MEMBER)

  // Hashed, exactly like a refresh token. A leaked database must not hand
  // anybody a working way into somebody's books.
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  // One invite row per address per business. Inviting the same person again
  // replaces the token, rather than leaving two live links to one set of books.
  @@unique([businessId, email])
  @@index([businessId])
  @@map("invite")
}

// --------------------------------------------------------- admin audit ----
// Superadmin is the one place businessId scoping is deliberately bypassed, so
// it is the one place every read is recorded. Written by the admin routes
// themselves and by nothing a customer can reach.
model AdminAudit {
  id          String   @id @default(cuid())
  actorUserId String   @map("actor_user_id")
  action      String
  businessId  String?  @map("business_id")
  detail      String?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([createdAt])
  @@map("admin_audit")
}

// ------------------------------------------------------------ category ----
// What an entry can be filed under. Seeded for every business at signup, so
// the first expense has somewhere to go without a trip to Settings first.
model Category {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name String
  kind CategoryKind

  // Owner Drawings is the one that cannot be renamed or removed. It is what
  // keeps profit honest: anything filed under it stays out of profit, out of
  // expense reports and out of the input tax credit, and a category that could
  // be renamed into an ordinary expense would quietly break all three.
  isSystem  Boolean @default(false) @map("is_system")
  sortOrder Int     @default(0) @map("sort_order")

  vendors      Vendor[]
  transactions Transaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Archived, never deleted. A category attached to last year's entries has to
  // go on existing for the CRA's six years, long after anyone files under it.
  archivedAt DateTime? @map("archived_at")

  @@unique([businessId, kind, name])
  @@index([businessId])
  @@map("category")
}

// -------------------------------------------------------------- vendor ----
// Who money goes out to, grouped under an expense category, so that choosing
// Bills Payment offers the utility companies rather than a list of forty names.
model Vendor {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name       String
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  @@unique([businessId, name])
  @@index([businessId])
  @@index([categoryId])
  @@map("vendor")
}

// -------------------------------------------------------------- client ----
// Who pays you. Deliberately thin at this stage: income needs somebody to
// attribute a payment to, and the client screens, their terms and their
// invoice history are Phase 6. Adding the table now rather than later is what
// stops the income form being built twice.
model Client {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?

  transactions Transaction[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  @@unique([businessId, name])
  @@index([businessId])
  @@map("client")
}

// --------------------------------------------------------- transaction ----
// The ledger. Every dollar in or out of the business is a row here, and it is
// the core of the whole product.
//
// APPEND ONLY. Nothing in this table is ever UPDATEd or DELETEd once written,
// which is rule 5 of the financial architecture and is not negotiable:
//
//   editing an entry   writes a REVERSAL of the original, then a new ENTRY
//   deleting an entry  writes a REVERSAL and nothing else
//
// So the sum of every row in a period is always the true figure, whatever
// happened along the way, and "what did this look like in March" is a question
// the database can still answer in six years. The only place rows are written
// is lib/ledger.ts; a Prisma write to this table from anywhere else is a bug.
//
// The live entries are the ones with no reversal pointing at them, which is
// why `reversal` is a one to one back relation rather than a flag: setting a
// flag would be an UPDATE, and there are none.
model Transaction {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type TransactionType
  kind LedgerKind      @default(ENTRY)

  // The day the money actually moved, which is not the day it was typed in.
  // Date only: a time of day on a bookkeeping entry is noise that shifts
  // across timezones and puts entries in the wrong month.
  date        DateTime @db.Date
  description String

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Expenses only. Who the money went to.
  vendorId String? @map("vendor_id")
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  // Income only. Who the money came from.
  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // ---- money, in whole cents, and all three stored ----
  //
  // The total is stored rather than derived from the other two. It is the
  // figure that appeared on the receipt or landed in the bank, and it is what
  // the customer will check against their statement. Deriving it would mean a
  // rounding rule change one day silently rewrites history.
  subtotalCents Int @map("subtotal_cents")
  taxCents      Int @map("tax_cents")
  totalCents    Int @map("total_cents")

  taxMode TaxMode @map("tax_mode")

  // The rate that applied ON THE DAY, in basis points, and the words that went
  // with it. Copied onto the row and never read back from the province table,
  // because Nova Scotia went from 15% to 14% in 2025 and a 2024 entry must
  // still read 15%.
  taxRateBp Int    @map("tax_rate_bp")
  taxLabel  String @map("tax_label")

  paymentMethod PaymentMethod? @map("payment_method")
  reference     String?

  // Drawings only, and required for one. 150 characters, so that this still
  // makes sense to an accountant at year end.
  purpose String?

  // ---- the audit trail ----
  //
  // On a REVERSAL, the ENTRY it cancels. Unique, so one entry can be reversed
  // exactly once and a double click cannot cancel the same money twice.
  reversesId String?      @unique @map("reverses_id")
  reverses   Transaction? @relation("reversal", fields: [reversesId], references: [id])
  reversal   Transaction? @relation("reversal")

  // On the ENTRY written by an edit, the entry it stands in for. Not unique
  // and not a constraint, because it is a history pointer: an entry corrected
  // three times leaves a chain of three.
  replacesId String? @map("replaces_id")

  // Who typed it. A relation rather than a bare id, because on an account with
  // three people the first question about a changed figure is who changed it,
  // and the answer should not need a second query to find.
  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([businessId, date])
  @@index([businessId, type, date])
  @@index([categoryId])
  @@index([vendorId])
  @@index([clientId])
  @@map("transaction")
}

// ----------------------------------------------------- idempotency key ----
// Rule 4 of the financial architecture: a write that arrives twice must not
// post the money twice.
//
// The client sends X-Idempotency-Key. The first request stores its own answer
// against that key; a repeat gets the stored answer back, byte for byte,
// without touching the ledger. That covers a double clicked button, a retried
// request on a flaky connection, and a voice entry confirmed twice, which are
// the three ways this actually happens.
model IdempotencyKey {
  id         String @id @default(cuid())
  businessId String @map("business_id")
  key        String

  // Stored so the same key cannot be replayed against a different endpoint and
  // hand back an answer that was never about this request.
  endpoint String
  status   Int
  response Json

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([businessId, key])
  @@index([createdAt])
  @@map("idempotency_key")
}
