// =============================================================================
// Variantage Finance: database schema
//
// Built on the seven decisions in docs/data-model.html. The four that shape
// every model below, and must not be quietly undone:
//
//   · Money is stored as WHOLE CENTS in Int columns, never Decimal or Float.
//     0.1 has no exact binary representation, and a tax total a cent out is a
//     tax total that is wrong.
//   · Tax is STORED, never recalculated. Each row keeps the rate that applied
//     and the amount charged, so a rate change never rewrites history.
//     Nova Scotia went 15% to 14% in 2025 and old invoices must still show 15%.
//   · Nothing is truly deleted. `deletedAt` marks a row as removed. The CRA
//     wants six years, and an invoice number must never be reissued.
//   · Multi-tenant from day one. Every business-owned table carries businessId
//     and every query is scoped to it.
//
// This file currently covers the Account & access group, which is what Phase 2
// needs. The remaining groups are added in their own phases. See PLAN.md.
// =============================================================================

generator client {
  // Prisma 7 generates into the project rather than into node_modules, so the
  // client is visible, typed and committed-adjacent. `output` is required.
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7 no longer takes the URL here. Migrations read it from
  // prisma.config.ts, and the running client gets it through the pg adapter in
  // src/lib/prisma.ts. One env var still drives both.
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums ----

enum BusinessType {
  SOLE_PROPRIETOR
  PARTNERSHIP
  CORPORATION
  CONTRACTOR
}

enum Currency {
  CAD
  USD
  PKR
}

// Inside one business. The owner pays and controls membership.
enum BusinessRole {
  OWNER
  MEMBER
}

// Above tenancy. SUPERADMIN is Variantage staff and belongs to no business.
// A customer can never grant it.
enum PlatformRole {
  SUPERADMIN
  CUSTOMER
}

// The two plans. They unlock exactly the same software; the difference is
// whether a real person keeps the books. So this is a support routing flag,
// never a permission, and nothing in the code branches on it.
enum Plan {
  ESSENTIAL
  SOLUTIONS_360
}

// Mirrors Stripe's own subscription statuses, narrowed to the ones this
// product can actually be in. Kept as our own enum rather than a raw string so
// that a typo in a webhook handler is a compile error.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
  INCOMPLETE
}

enum PaymentStatus {
  PAID
  FAILED
  REFUNDED
}

enum CategoryKind {
  INCOME
  EXPENSE
  DRAWINGS
}

// What a row of money is. Owner drawings are their own type rather than a
// category on an expense, because the difference is not a label: a drawing
// must never reach net profit, an expense report, or an input tax credit.
// Enforcing that at query level on a typed column is a rule the code cannot
// forget; enforcing it by remembering to exclude a category is one it will.
enum TransactionType {
  INCOME
  EXPENSE
  DRAWING
}

// How the person typed the amount in. This is the single most common source of
// wrong entries in small business books, which is why it is asked once, in
// plain words, instead of being guessed.
enum TaxMode {
  ADD // the figure is before tax, so add it
  INCLUSIVE // the figure already includes tax, so work it back out
  NONE // no tax on this entry at all
}

enum PaymentMethod {
  BANK_TRANSFER
  E_TRANSFER
  CHEQUE
  CASH
  CARD
  PRE_AUTHORISED
  OTHER
}

// What has happened to something dictated out loud.
//
// A voice entry is a PROPOSAL, never money. It is parsed, stored as a draft,
// and shown to the owner, and it only becomes a ledger row when a human has
// looked at it and pressed Save. Nothing here is ever counted anywhere: the
// figures on every screen come from the transaction table, and a draft that is
// never confirmed simply expires unread.
enum VoiceStatus {
  DRAFT // parsed, waiting for a person to check it
  CONFIRMED // a person approved it and it became a ledger entry
  DISCARDED // a person threw it away
  FAILED // nothing usable was in it, usually no amount
}

// A ledger row is written once and never touched again. An edit writes a
// reversal and a replacement; a delete writes a reversal alone.
enum LedgerKind {
  ENTRY // something that happened
  REVERSAL // the cancellation of an ENTRY, with the amounts negated
}

// How a discount was expressed when it was typed. The money that comes off is
// always stored in cents; this only exists so the edit form can show the
// customer the same control they used, rather than a converted figure.
enum DiscountMode {
  AMOUNT
  PERCENT
}

// ------------------------------------------------------------- business ----
// The tenant. Everything else hangs off this row.
model Business {
  id           String       @id @default(cuid())
  name         String
  legalName    String?      @map("legal_name")
  businessType BusinessType @default(SOLE_PROPRIETOR) @map("business_type")

  // CRA identifiers. gstHstNumber is the 15-character registration
  // (e.g. 123456789 RT0001) and is printed on every invoice. Without it the
  // client can be refused their input tax credit.
  businessNumber String? @map("business_number")
  gstHstNumber   String? @map("gst_hst_number")
  gstRegistered  Boolean @default(false) @map("gst_registered")

  // Province drives the default tax rate, so it is not a free-text field.
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  province     String  @default("ON")
  postalCode   String? @map("postal_code")
  country      String  @default("CA")

  email   String?
  phone   String?
  website String?

  currency     Currency @default(CAD)
  dateFormat   String   @default("YYYY/MM/DD") @map("date_format")
  fyStartMonth Int      @default(1) @map("fy_start_month")

  // Invoice template, auto-filled on every new invoice so nothing is retyped.
  invoicePrefix     String  @default("INV-") @map("invoice_prefix")
  nextInvoiceNumber Int     @default(1) @map("next_invoice_number")
  invoiceNumberPad  Int     @default(4) @map("invoice_number_pad")
  paymentTermsDays  Int     @default(30) @map("payment_terms_days")
  invoiceTerms      String? @map("invoice_terms")
  invoiceFooter     String? @map("invoice_footer")
  invoicePayTo      String? @map("invoice_pay_to")

  // Basis points, so 200 is 2% a month. Not a money column and not a Decimal:
  // an integer rate cannot drift, and it prints on the invoice as written.
  lateInterestBp Int? @default(200) @map("late_interest_bp")

  // The logo lives in object storage; these describe it so Settings can show
  // what is there without a round trip to the bucket. A new upload takes a new
  // key, because an issued invoice keeps the key it was printed with.
  logoKey         String?   @map("logo_key")
  logoFileName    String?   @map("logo_file_name")
  logoContentType String?   @map("logo_content_type")
  logoSizeBytes   Int?      @map("logo_size_bytes")
  logoUploadedAt  DateTime? @map("logo_uploaded_at")

  // Web only. The phone stays signed in until manual logout.
  idleTimeoutMinutes Int @default(15) @map("idle_timeout_minutes")
  idleWarningSeconds Int @default(60) @map("idle_warning_seconds")

  users           User[]
  sessions        Session[]
  subscription    Subscription?
  invites         Invite[]
  payments        Payment[]
  categories      Category[]
  vendors         Vendor[]
  clients         Client[]
  transactions    Transaction[]
  invoices        Invoice[]
  invoicePayments InvoicePayment[]
  voiceEntries    VoiceEntry[]
  attachments     Attachment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("business")
}

// ----------------------------------------------------------------- user ----
model User {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  email String @unique

  /**
   * Nullable because an account created through Google has no password. A user
   * can later set one, and a password user can later link Google, so the two
   * are not exclusive.
   */
  passwordHash String? @map("password_hash")

  /**
   * Google's stable subject id, not the email. Google emails can change and be
   * reassigned; the subject id cannot.
   */
  googleId     String?      @unique @map("google_id")
  avatarUrl    String?      @map("avatar_url")
  firstName    String       @map("first_name")
  lastName     String       @map("last_name")
  role         BusinessRole @default(OWNER)
  platformRole PlatformRole @default(CUSTOMER) @map("platform_role")

  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  // Set when a reset is requested; the token itself is stored hashed and the
  // link is good for one use inside 60 minutes.
  resetTokenHash    String?   @map("reset_token_hash")
  resetTokenExpires DateTime? @map("reset_token_expires")

  sessions        Session[]
  transactions    Transaction[]
  invoices        Invoice[]        @relation("invoiceAuthor")
  invoicePayments InvoicePayment[] @relation("invoicePaymentAuthor")
  voiceEntries    VoiceEntry[]     @relation("voiceAuthor")
  attachments     Attachment[]     @relation("attachmentAuthor")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([businessId])
  @@map("user")
}

// -------------------------------------------------------------- session ----
// Drives the 15-minute idle logout on web. A refresh token is stored hashed so
// a database leak cannot be replayed as a login.
model Session {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique @map("refresh_token_hash")

  /**
   * Whether the person ticked "keep me signed in".
   * Stored on the session, not worked out from the expiry date, so a refresh
   * carries the original choice forward instead of quietly upgrading a shared
   * computer to a month long session.
   */
  remembered Boolean   @default(true)
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([businessId])
  @@map("session")
}

// -------------------------------------------------------- subscription ----
// One per business. Holds what Stripe knows, mirrored locally, so that
// deciding whether someone may write to their own books never depends on a
// network call to a third party.
//
// The only question this table has to answer is: may this business write right
// now, yes or no. Both plans unlock the same software, so there is no per
// feature entitlement anywhere in this codebase and there must not be one.
model Subscription {
  id         String   @id @default(cuid())
  businessId String   @unique @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  plan   Plan               @default(ESSENTIAL)
  status SubscriptionStatus @default(TRIALING)

  // People beyond the owner, 0 to 2, at $5 each and free until the trial ends.
  // Kept here rather than counted from the user table, because the bill has to
  // survive a member being removed halfway through a month.
  extraSeats Int @default(0) @map("extra_seats")

  // The trial is ours. It starts at signup and exists whether or not Stripe
  // has ever been contacted. When a card is added, this same instant is handed
  // to Stripe as trial_end, so nobody is quietly given 14 more days.
  trialEndsAt DateTime? @map("trial_ends_at")

  currentPeriodEnd  DateTime? @map("current_period_end")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")

  // Stripe's side. Nullable throughout, because an account inside its trial
  // has never been to checkout, and that is the ordinary state for 14 days.
  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")

  // The two subscription items: the plan line and the per seat line. Stored so
  // that a seat change is an update to a known item, rather than a search
  // through the subscription every time somebody is added.
  stripeBaseItemId String? @map("stripe_base_item_id")
  stripeSeatItemId String? @map("stripe_seat_item_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscription")
}

// ------------------------------------------------------------- payment ----
// Written from Stripe webhooks only, never from a request. A local copy of
// what Stripe charged, so the billing history and the superadmin panel can
// render a table without a Stripe API call.
model Payment {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Whole cents, like every other money column in this schema.
  amountCents Int           @map("amount_cents")
  currency    String        @default("cad")
  status      PaymentStatus
  description String?

  // Unique, so a webhook delivered twice cannot produce two rows.
  stripeInvoiceId String?   @unique @map("stripe_invoice_id")
  paidAt          DateTime? @map("paid_at")
  failureReason   String?   @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId])
  @@map("payment")
}

// ------------------------------------------------------- webhook event ----
// Stripe guarantees at-least-once delivery, which makes duplicates normal
// rather than exceptional. The event id is the primary key, so a replay is a
// unique violation instead of a second payment recorded.
model WebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("webhook_event")
}

// -------------------------------------------------------------- invite ----
// The owner types an email address, and that person sets their own password on
// a single use link. Deliberately not a generated password sent by email,
// which would sit in that inbox in plain text for as long as the account
// exists, so anyone who ever reaches the mailbox reaches the books.
model Invite {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  email String
  role  BusinessRole @default(MEMBER)

  // Hashed, exactly like a refresh token. A leaked database must not hand
  // anybody a working way into somebody's books.
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  // One invite row per address per business. Inviting the same person again
  // replaces the token, rather than leaving two live links to one set of books.
  @@unique([businessId, email])
  @@index([businessId])
  @@map("invite")
}

// --------------------------------------------------------- admin audit ----
// Superadmin is the one place businessId scoping is deliberately bypassed, so
// it is the one place every read is recorded. Written by the admin routes
// themselves and by nothing a customer can reach.
model AdminAudit {
  id          String   @id @default(cuid())
  actorUserId String   @map("actor_user_id")
  action      String
  businessId  String?  @map("business_id")
  detail      String?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([createdAt])
  @@map("admin_audit")
}

// ------------------------------------------------------------ category ----
// What an entry can be filed under. Seeded for every business at signup, so
// the first expense has somewhere to go without a trip to Settings first.
model Category {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name String
  kind CategoryKind

  // Owner Drawings is the one that cannot be renamed or removed. It is what
  // keeps profit honest: anything filed under it stays out of profit, out of
  // expense reports and out of the input tax credit, and a category that could
  // be renamed into an ordinary expense would quietly break all three.
  isSystem  Boolean @default(false) @map("is_system")
  sortOrder Int     @default(0) @map("sort_order")

  vendors      Vendor[]
  transactions Transaction[]
  voiceEntries VoiceEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Archived, never deleted. A category attached to last year's entries has to
  // go on existing for the CRA's six years, long after anyone files under it.
  archivedAt DateTime? @map("archived_at")

  @@unique([businessId, kind, name])
  @@index([businessId])
  @@map("category")
}

// -------------------------------------------------------------- vendor ----
// Who money goes out to, grouped under an expense category, so that choosing
// Bills Payment offers the utility companies rather than a list of forty names.
model Vendor {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name       String
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  voiceEntries VoiceEntry[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  @@unique([businessId, name])
  @@index([businessId])
  @@index([categoryId])
  @@map("vendor")
}

// -------------------------------------------------------------- client ----
// Who pays you. Deliberately thin at this stage: income needs somebody to
// attribute a payment to, and the client screens, their terms and their
// invoice history are Phase 6. Adding the table now rather than later is what
// stops the income form being built twice.
model Client {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  contactName String? @map("contact_name")
  email       String?
  phone       String?

  // The billing address, which the CRA wants on any invoice of $30 or more.
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  province     String?
  postalCode   String? @map("postal_code")

  // Overrides the business default when this client has been given their own
  // terms. Null means use the template.
  paymentTermsDays Int? @map("payment_terms_days")

  notes String?

  transactions Transaction[]
  invoices     Invoice[]
  voiceEntries VoiceEntry[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  @@unique([businessId, name])
  @@index([businessId])
  @@map("client")
}

// --------------------------------------------------------- transaction ----
// The ledger. Every dollar in or out of the business is a row here, and it is
// the core of the whole product.
//
// APPEND ONLY. Nothing in this table is ever UPDATEd or DELETEd once written,
// which is rule 5 of the financial architecture and is not negotiable:
//
//   editing an entry   writes a REVERSAL of the original, then a new ENTRY
//   deleting an entry  writes a REVERSAL and nothing else
//
// So the sum of every row in a period is always the true figure, whatever
// happened along the way, and "what did this look like in March" is a question
// the database can still answer in six years. The only place rows are written
// is lib/ledger.ts; a Prisma write to this table from anywhere else is a bug.
//
// The live entries are the ones with no reversal pointing at them, which is
// why `reversal` is a one to one back relation rather than a flag: setting a
// flag would be an UPDATE, and there are none.
model Transaction {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type TransactionType
  kind LedgerKind      @default(ENTRY)

  // The day the money actually moved, which is not the day it was typed in.
  // Date only: a time of day on a bookkeeping entry is noise that shifts
  // across timezones and puts entries in the wrong month.
  date        DateTime @db.Date
  description String

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Expenses only. Who the money went to.
  vendorId String? @map("vendor_id")
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  // Income only. Who the money came from.
  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // ---- money, in whole cents, and all three stored ----
  //
  // The total is stored rather than derived from the other two. It is the
  // figure that appeared on the receipt or landed in the bank, and it is what
  // the customer will check against their statement. Deriving it would mean a
  // rounding rule change one day silently rewrites history.
  subtotalCents Int @map("subtotal_cents")
  taxCents      Int @map("tax_cents")
  totalCents    Int @map("total_cents")

  taxMode TaxMode @map("tax_mode")

  // The rate that applied ON THE DAY, in basis points, and the words that went
  // with it. Copied onto the row and never read back from the province table,
  // because Nova Scotia went from 15% to 14% in 2025 and a 2024 entry must
  // still read 15%.
  taxRateBp Int    @map("tax_rate_bp")
  taxLabel  String @map("tax_label")

  paymentMethod PaymentMethod? @map("payment_method")
  reference     String?

  // Drawings only, and required for one. 150 characters, so that this still
  // makes sense to an accountant at year end.
  purpose String?

  // ---- the audit trail ----
  //
  // On a REVERSAL, the ENTRY it cancels. Unique, so one entry can be reversed
  // exactly once and a double click cannot cancel the same money twice.
  reversesId String?      @unique @map("reverses_id")
  reverses   Transaction? @relation("reversal", fields: [reversesId], references: [id])
  reversal   Transaction? @relation("reversal")

  // The dictated draft this entry came from, if it came from one. A back
  // relation only: the draft points here, not the other way round, because an
  // entry is money and a draft is a proposal that happened to precede it.
  voiceEntry VoiceEntry?

  // On the ENTRY written by an edit, the entry it stands in for. Not unique
  // and not a constraint, because it is a history pointer: an entry corrected
  // three times leaves a chain of three.
  replacesId String? @map("replaces_id")

  // Set when this income entry was posted by a payment on an invoice. It is
  // the single link between the two, in both directions, so there is no
  // denormalised invoice id to drift.
  //
  // An entry with one of these cannot be edited or removed from the income
  // screen. Changing it there would move the money without moving the invoice
  // balance, which is exactly the double counting the link exists to prevent.
  invoicePayment InvoicePayment?

  // The receipts behind this entry. Not money, so not bound by append only:
  // when an entry is corrected, its receipts are moved onto the replacement
  // in the same database transaction, because the paper did not change.
  attachments Attachment[]

  // Who typed it. A relation rather than a bare id, because on an account with
  // three people the first question about a changed figure is who changed it,
  // and the answer should not need a second query to find.
  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([businessId, date])
  @@index([businessId, type, date])
  @@index([categoryId])
  @@index([vendorId])
  @@index([clientId])
  @@map("transaction")
}

// ----------------------------------------------------- idempotency key ----
// Rule 4 of the financial architecture: a write that arrives twice must not
// post the money twice.
//
// The client sends X-Idempotency-Key. The first request stores its own answer
// against that key; a repeat gets the stored answer back, byte for byte,
// without touching the ledger. That covers a double clicked button, a retried
// request on a flaky connection, and a voice entry confirmed twice, which are
// the three ways this actually happens.
model IdempotencyKey {
  id         String @id @default(cuid())
  businessId String @map("business_id")
  key        String

  // Stored so the same key cannot be replayed against a different endpoint and
  // hand back an answer that was never about this request.
  endpoint String
  status   Int
  response Json

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([businessId, key])
  @@index([createdAt])
  @@map("idempotency_key")
}

// ------------------------------------------------------------- invoice ----
// A document, not a view over current settings.
//
// The seller's name, address and registration number are COPIED onto the
// invoice when it is issued, along with the terms, the footer and the tax
// rate. Rendering it from today's settings would mean a business that moved
// premises silently reprinting last year's invoices with the new address, and
// the copy the client is holding would stop matching ours.
//
// Status is NEVER stored. It is worked out from the payments and the due date
// every time it is asked for, so the pill, the totals, the client's balance
// and the dashboard cannot disagree about the same invoice.
model Invoice {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String   @map("client_id")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // The formatted number as printed, and the plain integer behind it. Both,
  // because the format can change and the sequence cannot: an invoice number
  // is never reissued, and the unique index below is what enforces that.
  number      String
  numberValue Int    @map("number_value")

  issueDate        DateTime @map("issue_date") @db.Date
  dueDate          DateTime @map("due_date") @db.Date
  paymentTermsDays Int      @map("payment_terms_days")

  // ---- copied from the business at issue ----
  sellerName    String  @map("seller_name")
  sellerAddress String? @map("seller_address")
  sellerEmail   String? @map("seller_email")
  sellerPhone   String? @map("seller_phone")
  gstHstNumber  String? @map("gst_hst_number")
  // The logo as it was when the invoice was raised. Storage never deletes an
  // object an invoice still points at, so a new logo cannot reprint old ones.
  sellerLogoKey String? @map("seller_logo_key")

  // ---- copied from the client at issue ----
  billToName    String  @map("bill_to_name")
  billToContact String? @map("bill_to_contact")
  billToAddress String? @map("bill_to_address")

  invoiceTerms  String? @map("invoice_terms")
  invoiceFooter String? @map("invoice_footer")
  invoicePayTo  String? @map("invoice_pay_to")

  // ---- money, whole cents ----
  //
  // The discount comes off BEFORE tax, which is how the CRA expects it and
  // what the mockup says on screen. taxableCents is what the tax was actually
  // charged on, stored rather than derived so the arithmetic on the document
  // can always be checked line by line.
  subtotalCents Int          @map("subtotal_cents")
  discountMode  DiscountMode @default(AMOUNT) @map("discount_mode")
  // Cents when the mode is AMOUNT, basis points when it is PERCENT. What the
  // customer typed, kept so the edit form can show it back to them.
  discountValue Int          @default(0) @map("discount_value")
  discountCents Int          @default(0) @map("discount_cents")
  taxableCents  Int          @map("taxable_cents")
  taxCents      Int          @map("tax_cents")
  totalCents    Int          @map("total_cents")

  // Off for a genuinely zero rated or exempt sale. On by default, with the
  // rate coming from the province rather than being asked for.
  chargeTax Boolean @default(true) @map("charge_tax")
  taxRateBp Int     @map("tax_rate_bp")
  taxLabel  String  @map("tax_label")

  notes String?

  // Draft until this is set. A draft is not a debt the client owes, so it is
  // excluded from what they are billed and from what the business is owed.
  sentAt DateTime? @map("sent_at")

  // Removed, without leaving the sequence. An invoice number is never
  // reissued, so the row has to stay even when the invoice does not.
  voidedAt DateTime? @map("voided_at")

  items       InvoiceItem[]
  payments    InvoicePayment[]
  attachments Attachment[]

  // Who raised it, for the audit trail on a shared account.
  createdById String   @map("created_by_id")
  createdBy   User     @relation("invoiceAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // One number per business, ever. This is the constraint that makes the
  // sequence unbroken rather than merely intended to be.
  @@unique([businessId, numberValue])
  @@index([businessId, issueDate])
  @@index([clientId])
  @@map("invoice")
}

// -------------------------------------------------------- invoice item ----
model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String

  // Thousandths, so 7.5 hours is 7500. An integer for the same reason money is
  // an integer: 0.1 has no exact binary form, and a quantity that drifts makes
  // a line total that does not match its own rate.
  quantityMilli  Int @map("quantity_milli")
  unitPriceCents Int @map("unit_price_cents")
  // Rounded once, here, and stored. Recomputing it on read would let a change
  // to the rounding rule rewrite a document somebody is already holding.
  lineTotalCents Int @map("line_total_cents")

  sortOrder Int @default(0) @map("sort_order")

  @@index([invoiceId])
  @@map("invoice_item")
}

// ----------------------------------------------------- invoice payment ----
// The link between an invoice and the income entry its payment posted.
//
// Recording a payment writes exactly one INCOME transaction through the ledger
// service and joins it here. That is what stops the same money being counted
// twice: there is no second place to record it, and the entry it created
// cannot be edited from the income screen.
//
// There is no voided flag. Whether a payment still counts is decided by
// whether its ledger entry has been reversed, so there is one truth rather
// than two that can disagree.
model InvoicePayment {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId  String   @map("invoice_id")
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  date        DateTime       @db.Date
  amountCents Int            @map("amount_cents")
  method      PaymentMethod?
  reference   String?

  // Unique: one payment, one ledger entry, in both directions.
  transactionId String      @unique @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  // Who recorded it. Shown on the payment history, because on a shared account
  // "who marked this as paid" is a question that gets asked.
  createdById String   @map("created_by_id")
  createdBy   User     @relation("invoicePaymentAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([businessId])
  @@map("invoice_payment")
}

// ---------------------------------------------------------- attachment ----
// A receipt or document, never a loose file. It belongs to exactly one ledger
// entry or one invoice, and a CHECK constraint in the migration holds that:
// a file attached to nothing is a file nobody will ever find again.
//
// The bytes live in the private bucket under `key`; this row is what makes
// them findable. Removing a receipt deletes the object and keeps the row with
// `deletedAt`, so "who removed the proof for this expense" still has an
// answer after the file itself is gone.
model Attachment {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  transactionId String?      @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  invoiceId     String?      @map("invoice_id")
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  key String @unique

  // What the owner called it, cleaned, with the extension the bytes proved.
  fileName String @map("file_name")
  // Worked out from the bytes on upload, never taken from the browser.
  contentType String @map("content_type")
  sizeBytes   Int    @map("size_bytes")

  createdById String   @map("created_by_id")
  createdBy   User     @relation("attachmentAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  @@index([businessId, deletedAt])
  @@index([transactionId])
  @@index([invoiceId])
  @@map("attachment")
}


model VoiceEntry {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  status VoiceStatus @default(DRAFT)

  // What was actually said, as the model heard it. Kept because the owner is
  // shown it next to the fields, and because "it recorded the wrong amount" is
  // answerable only if the sentence is still there.
  transcript String

  // ---- what the model PROPOSED ----
  //
  // Typed columns rather than a JSON blob, so a proposal can be read and
  // audited with the same tools as everything else. All nullable: a sentence
  // with no amount in it produces a row with nothing but a transcript, which
  // is the honest record of a failure.
  kind        TransactionType?
  amountCents Int?             @map("amount_cents")
  taxMode     TaxMode?         @map("tax_mode")

  // The names it heard, kept as spoken. They are matched against the business's
  // own categories, vendors and clients where a match exists; where none does,
  // the id stays null and the confirmation screen asks. Nothing is created from
  // speech: a vendor nobody has ever entered is not invented here.
  party       String?
  description String?
  entryDate   DateTime? @map("entry_date") @db.Date
  purpose     String?

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendorId   String?   @map("vendor_id")
  vendor     Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  clientId   String?   @map("client_id")
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Which fields were inferred rather than heard, and why, as { field: reason }.
  // JSON because it is a note to a human rather than something queried, and
  // because the set of fields it can cover changes with the prompt.
  guesses Json?

  // The model that answered, so a change in behaviour can be traced to a change
  // in model rather than to a change in our code.
  model String

  // What it became, if anything. Unique: one draft, one entry.
  transactionId String?      @unique @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  createdById String   @map("created_by_id")
  createdBy   User     @relation("voiceAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  settledAt   DateTime? @map("settled_at")

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@map("voice_entry")
}
